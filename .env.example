# ==============================================================================
# SentinelOS Environment Configuration Template
# ==============================================================================

# Core Server Configuration
HOST=0.0.0.0
PORT=8001
SENTINEL_ROLE=core

# Local Inactive / Active Cognitive Engine
LLAMA_SERVER_API_URL=http://127.0.0.1:8080
OLLAMA_API_URL=http://127.0.0.1:11434

# NVIDIA Cloud Flagship Fallback (Optional)
NVIDIA_API_KEY=
NVIDIA_MODEL=mistralai/mistral-nemotron

# Sentinel Mesh Hub & Multi-Server Security Token
SENTINEL_MESH_TOKEN=change_this_secret_token_in_production

# Skills Configuration
KLIPPER_SERIAL=/dev/ttyUSB0
KLIPPER_BAUDRATE=250000
KLIPPER_WEBCAM=true

VOICE_WAKE_WORD=sentinel
VOICE_TTS_MODEL=es_ES-davefx-medium
VOICE_ALEXA_BRIDGE=true

NETSEC_SUBNET=192.168.1.0/24
NETSEC_MODE=safe
