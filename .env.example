# ==============================================================================
# SentinelOS Environment Configuration Template
# ==============================================================================

# Core Server Configuration
HOST=0.0.0.0
PORT=8001
SENTINEL_ROLE=core

# AI runs only on the HP Ubuntu server (hostname: labsentinel). Sentinel Mesh
# discovers its current private IP over UDP 8003; mDNS is the fallback.
# The HP must run SentinelOS and allow Ollama on the private LAN.
# Override only if the HP uses a different hostname:
# OLLAMA_API_URL=http://labsentinel.local:11434
# Optional llama-server on that same HP:
# LLAMA_SERVER_API_URL=http://labsentinel.local:8080

# NVIDIA Cloud Flagship Fallback (Optional)
NVIDIA_API_KEY=
NVIDIA_MODEL=mistralai/mistral-nemotron

# Sentinel Mesh Hub & Multi-Server Security Token
SENTINEL_MESH_TOKEN=change_this_secret_token_in_production

# Skills Configuration
KLIPPER_SERIAL=/dev/ttyUSB0
KLIPPER_BAUDRATE=250000
KLIPPER_WEBCAM=true

VOICE_WAKE_WORD=sentinel
VOICE_TTS_MODEL=es_ES-davefx-medium
VOICE_ALEXA_BRIDGE=true

NETSEC_SUBNET=192.168.1.0/24
NETSEC_MODE=safe
