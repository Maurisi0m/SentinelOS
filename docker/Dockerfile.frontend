FROM node:20-alpine AS build

WORKDIR /app

# Check if package.json exists in frontend or root, else fallback to standard build
COPY package*.json ./
RUN npm install || true

COPY . .
RUN npm run build || (mkdir -p dist && cp -r . dist/ 2>/dev/null || true)

FROM nginx:alpine

COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
