FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    iproute2 \
    iputils-ping \
    net-tools \
    arp-scan \
    nmap \
    && rm -rf /var/lib/apt/lists/*

COPY labsentinel_backend/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt || pip install --no-cache-dir fastapi uvicorn aiohttp psutil pydantic requests

COPY labsentinel_backend/ /app/

EXPOSE 8001

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8001"]
